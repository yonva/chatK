# Salin ke .env.local di root. Isi dari dashboard Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional: server-only, gunakan hanya bila alur server benar-benar memerlukannya.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary. API secret hanya boleh digunakan di server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=